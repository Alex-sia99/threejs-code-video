# Copiez ce fichier en `.env` (jamais commité) et remplissez :
# Clé ElevenLabs — le plus simple : `npx -y @elevenlabs/cli@latest onboard init` (ouvre le navigateur, écrit la clé ici)
ELEVENLABS_API_KEY=
# Identifiant d'une voix ElevenLabs (clonée ou pré-faite) utilisée pour "voice": "me" dans src/film/script.json
VOICE_ME=
